{
  "name": "rankfix-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "testlab:144:check": "node --test tests/testlab-144.test.mjs",
    "testlab:144:dry": "node scripts/testlab/run.mjs --phase lab144 --dry-run",
    "testlab:144:start": "node scripts/testlab/run.mjs --phase lab144",
    "load:test": "node scripts/load-test.mjs",
    "test:fix-flow": "RF_REAL_DB=1 node --experimental-strip-types --no-warnings --import ./tests/scan-matrix/register.mjs tests/fix-engine/run-flow-pg.mjs",
